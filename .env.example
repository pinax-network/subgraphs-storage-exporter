# Copy to .env for local testing (`.env` is gitignored). Bun auto-loads .env.
# POSTGRES_PASSWORD is required; everything else has a default.

# POSTGRES_PASSWORD=REPLACE_ME
# POSTGRES_USER=graph
# POSTGRES_DB=graph

# The shared primary that holds public.deployment_schemas (sgd<N> → deployment mapping for all shards).
# PRIMARY_HOST=postgres-0.postgres.subgraphs:5432

# Every Postgres holding sgd<N> data (host:port, comma-separated) — include the primary if it holds
# deployments. Kept explicit so the shard topology is visible; update when adding a chain/shard.
# SHARD_HOSTS=postgres-0.postgres.subgraphs:5432,postgres-2.postgres.subgraphs:5432,postgres-core-0.postgres-core.subgraphs-arbitrum-one:5432,...

# REFRESH_SECONDS=300   # disk moves slowly; sizing is a metadata lookup, not a scan
# PORT=9402
