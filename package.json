{
  "name": "subgraphs-storage-exporter",
  "version": "0.1.0",
  "description": "Prometheus exporter for per-subgraph on-disk footprint — sizes each graph-node sgd<N> schema across the sharded Postgres backend",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "typecheck": "bun --bun tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "onFail": "error"
    }
  }
}
